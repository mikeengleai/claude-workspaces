def workspace_project_dir(name):
    """Return the Claude project directory for a workspace (parent of memory/)."""
    return workspace_memory_dir(name).parent


def ensure_archive_dir():
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)


def lineage_path(name):
    return WORKSPACES_DIR / name / "LINEAGE.md"


def append_lineage(name, archived_as, before_count, after_count, handoff_note):
    """Append a row to the new workspace's LINEAGE.md (creating it if needed)."""
    lp = lineage_path(name)
    _ensure_lineage_header(lp, name)
    ts = time.strftime("%Y-%m-%d %H:%M")
    if isinstance(handoff_note, bool):
        handoff_note = "yes" if handoff_note else "no"
    with lp.open("a") as f:
        f.write(f"| {ts} | {archived_as} | {before_count} | {after_count} | {handoff_note} |\n")


def append_lineage_refresh(name, before_count, after_count, handoff_note, label="reset"):
    """Append a light-reset row to LINEAGE.md (no full-workspace archive).

    `label` records what happened to the session history (e.g. the session-archive
    dir name, or 'purge (deleted)'). `handoff_note` records what happened to the
    handoff — 'regenerated', 'reused (stale)', and so on. A bare 'yes' hid the case
    that matters most: a months-old handoff carried forward untouched.
    """
    lp = lineage_path(name)
    _ensure_lineage_header(lp, name)
    ts = time.strftime("%Y-%m-%d %H:%M")
    if isinstance(handoff_note, bool):
        handoff_note = "yes" if handoff_note else "no"
    with lp.open("a") as f:
        f.write(f"| {ts} | {label} | {before_count} | {after_count} | {handoff_note} |\n")


def _ensure_lineage_header(lp, name):
    """Create LINEAGE.md with header if it doesn't exist."""
    if not lp.exists():
        lp.write_text(
            f"# {name} — workspace lineage\n\n"
            f"Each row records a context reset: the session was refreshed or rotated.\n\n"
            f"| Reset | Archived as | Memory before | Memory after | Handoff |\n"
            f"|---|---|---|---|---|\n"
        )


# How many transcripts beyond the resumed one the curator is asked to mine. Reading is not
# free, so this is capped — but never silently: whatever is left over is named in the prompt
# and in the archive MANIFEST.md so nothing drops out of view unannounced.
HANDOFF_REVIEW_LIMIT = 8


def workspace_session_jsonls(name):
    """All session transcripts for a workspace, newest first."""
    project_dir = workspace_project_dir(name)
    if not project_dir.exists():
        return []
    return sorted(project_dir.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)


def handoff_status(name, jsonls=None):
    """Classify the workspace's HANDOFF.md as 'missing', 'stale', or 'current'.

    A handoff is only 'current' when it was written AFTER every session transcript.
    If any transcript is newer, real work has happened since the document was written,
    and reusing it would seed the next session with an out-of-date picture — the exact
    way context goes missing across repeated resets.

    Returns (state, path, n_newer_transcripts).
    """
    hp = WORKSPACES_DIR / name / "HANDOFF.md"
    if not hp.exists():
        return "missing", hp, 0
    if jsonls is None:
        jsonls = workspace_session_jsonls(name)
    h_mtime = hp.stat().st_mtime
    newer = [j for j in jsonls if j.stat().st_mtime > h_mtime]
    if newer:
        return "stale", hp, len(newer)
    return "current", hp, 0


def handoff_history_dir(name):
    return WORKSPACES_DIR / name / "handoffs"


def preserve_existing_handoff(name):
    """Copy the current HANDOFF.md into <workspace>/handoffs/HANDOFF-<ts>.md.

    Every writer of HANDOFF.md calls this first, so a regenerated handoff can never
    erase the one it replaces. Returns the preserved path, or None if there was none.
    """
    hp = WORKSPACES_DIR / name / "HANDOFF.md"
    if not hp.exists():
        return None
    hist = handoff_history_dir(name)
    hist.mkdir(parents=True, exist_ok=True)
    ts = time.strftime("%Y%m%d-%H%M%S", time.localtime(hp.stat().st_mtime))
    dst = hist / f"HANDOFF-{ts}.md"
    if dst.exists():
        dst = hist / f"HANDOFF-{ts}-{int(time.time()*1000) % 1000}.md"
    import shutil
    shutil.copy2(str(hp), str(dst))
    print(f"  {DIM}Previous handoff preserved → handoffs/{dst.name}{RESET}")
    return dst


def handoff_adopt(name, source_file):
    """Copy/move an existing markdown to the workspace's HANDOFF.md."""
    workspace_dir = WORKSPACES_DIR / name
    if not workspace_dir.exists():
        print(f"  {RED}Workspace '{name}' does not exist.{RESET}")
        return None
    src = Path(source_file)
    if not src.exists():
        print(f"  {RED}Source markdown not found: {src}{RESET}")
        return None
    dst = workspace_dir / "HANDOFF.md"
    preserve_existing_handoff(name)
    import shutil
    shutil.copy2(str(src), str(dst))
    os.utime(str(dst), None)
    print(f"  {GREEN}Adopted {src} → {dst}{RESET}")
    return dst


def handoff_from_jsonl(name):
    """Regenerate HANDOFF.md by resuming the newest session transcript.

    The resumed conversation is the richest source, but it is not the only one: a
    workspace usually holds several transcripts and a reset archives all of them. So the
    curator is also handed the other transcripts (capped, with the remainder named) and
    the previous handoff, and is told the new document must be cumulative.

    Returns the handoff path on success, None on any failure — callers must treat None
    as "do not touch session history yet".
    """
    workspace_dir = WORKSPACES_DIR / name
    if not workspace_dir.exists():
        print(f"  {RED}Workspace '{name}' does not exist.{RESET}")
        return None

    jsonls = workspace_session_jsonls(name)
    if not jsonls:
        print(f"  {RED}No prior session jsonl found for '{name}'. Cannot generate handoff.{RESET}")
        return None
    session_id = jsonls[0].stem
    handoff_path = workspace_dir / "HANDOFF.md"

    # Keep the handoff we are about to replace, and point the curator at it.
    preserved = preserve_existing_handoff(name)
    prior_block = PRIOR_HANDOFF_BLOCK.format(prior_path=preserved) if preserved else ""

    # Everything except the resumed transcript is context the curator would otherwise miss.
    others = jsonls[1:]
    other_block = ""
    if others:
        review = others[:HANDOFF_REVIEW_LIMIT]
        skipped = others[HANDOFF_REVIEW_LIMIT:]
        lines = []
        for j in review:
            kb = j.stat().st_size // 1024
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(j.stat().st_mtime))
            lines.append(f"  - {j}  ({kb} KB, last written {when})")
        if skipped:
            unreviewed = (
                f"\nA further {len(skipped)} transcript(s) are being archived and are NOT listed "
                f"for review: {', '.join(j.name for j in skipped)}. Name them under \"Sessions not "
                f"reviewed\" in the Coverage section.\n"
            )
            print(f"  {YELLOW}{len(skipped)} older transcript(s) exceed the review cap "
                  f"({HANDOFF_REVIEW_LIMIT}) — they will be archived but not mined.{RESET}")
        else:
            unreviewed = ""
        other_block = OTHER_SESSIONS_BLOCK.format(
            total=len(jsonls), n_review=len(review) + 1,
            review_list="\n".join(lines), unreviewed_note=unreviewed,
        )

    prompt = HANDOFF_CURATOR_PROMPT.format(
        name=name, handoff_path=str(handoff_path),
        prior_handoff=prior_block, other_sessions=other_block,
    )
    print(f"  {CYAN}Generating handoff from session {session_id} "
          f"({len(jsonls)} transcript(s) in scope; this may take 1–3 minutes)…{RESET}")
    before_mtime = handoff_path.stat().st_mtime if handoff_path.exists() else 0
    result = subprocess.run(
        ["claude", "-p", prompt, "--resume", session_id, "--dangerously-skip-permissions"],
        cwd=str(workspace_dir),
    )
    if result.returncode != 0:
        print(f"  {RED}Handoff generator exited {result.returncode}.{RESET}")
        return None
    if not handoff_path.exists():
        print(f"  {RED}Generator finished but HANDOFF.md not written.{RESET}")
        return None
    if handoff_path.stat().st_mtime <= before_mtime:
        print(f"  {RED}Generator finished but HANDOFF.md was not updated.{RESET}")
        if preserved:
            print(f"  {DIM}Prior handoff is still intact at handoffs/{preserved.name}{RESET}")
        return None
    if handoff_path.stat().st_size < 512:
        print(f"  {RED}HANDOFF.md is only {handoff_path.stat().st_size} bytes — too thin to trust "
              f"as a replacement for {len(jsonls)} transcript(s).{RESET}")
        print(f"  {DIM}Inspect it, or re-run: cw handoff {name} --from-jsonl{RESET}")
        return None
    # Stamp it now so the staleness check sees it as newer than every transcript,
    # including any the generator run itself appended to.
    os.utime(str(handoff_path), None)
    print(f"  {GREEN}Wrote {handoff_path} ({handoff_path.stat().st_size} bytes){RESET}")
    return handoff_path


def cmd_handoff(name, mode, source=None):
    """User-facing handoff producer. mode in {'adopt', 'from-jsonl'}."""
    if mode == "adopt":
        if not source:
            print(f"  {RED}--adopt requires a source path.{RESET}")
            return
        handoff_adopt(name, source)
    elif mode == "from-jsonl":
        handoff_from_jsonl(name)
    else:
        print(f"  {RED}Unknown handoff mode: {mode}{RESET}")


def shelve_workspace(name):
    """Shelve (archive) a workspace so it no longer appears in the menu.

    Stops the tmux session if running, then archives.  Lighter than rotate —
    no compaction, no handoff, just hide it for later restore.
    """
    workspace_dir = WORKSPACES_DIR / name
    if not workspace_dir.exists():
        print(f"  {RED}Workspace '{name}' does not exist.{RESET}")
        return
    # Stop tmux session if running
    tmux_name = TMUX_PREFIX + name
    if tmux_session_exists(tmux_name):
        subprocess.run(["tmux", "kill-session", "-t", "=" + tmux_name], capture_output=True)
        print(f"  {YELLOW}Stopped running session '{name}'{RESET}")
    archive_workspace(name)


def archive_workspace(name):
    """Move the workspace dir AND its Claude project dir into ~/workspaces/.archive/<name>-<ts>/.

    Returns the archive root path on success, or None on failure.
    """
    workspace_dir = WORKSPACES_DIR / name
    project_dir = workspace_project_dir(name)
    if not workspace_dir.exists():
        print(f"  {RED}Workspace '{name}' does not exist.{RESET}")
        return None

    ensure_archive_dir()
    ts = time.strftime("%Y%m%d-%H%M%S")
    archive_root = ARCHIVE_DIR / f"{name}-{ts}"
    if archive_root.exists():
        # extreme edge: same-second collision; suffix with microseconds
        archive_root = ARCHIVE_DIR / f"{name}-{ts}-{int(time.time()*1000) % 1000}"
    archive_root.mkdir(parents=True)

    import shutil
    workspace_dir.rename(archive_root / "workspace")
    if project_dir.exists():
        project_dir.rename(archive_root / "project")

    # Record metadata for restore/purge.
    meta = {
        "name": name,
        "archived_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "workspace_dir": str(workspace_dir),
        "project_dir": str(project_dir),
    }
    (archive_root / "rotation-meta.json").write_text(json.dumps(meta, indent=2))

    # Drop sessions[name] so a future launch doesn't pick up stale --continue metadata.
    sessions = load_sessions()
    if name in sessions:
        del sessions[name]
        save_sessions(sessions)

    print(f"  {GREEN}Archived '{name}' → {archive_root.name}{RESET}")
    return archive_root


def archive_session_jsonls(name, jsonls, handoff_note="unknown"):
    """Archive session history (light reset) into ~/workspaces/.archive/<name>-<ts>-session/.

    The archive is made self-contained so that "go back and check what the handoff missed"
    is cheap and complete:
      - every session transcript
      - each transcript's sidecar directory (tool-results/ etc.), which the jsonl
        references by relative path and which is useless once separated from it
      - a copy of the HANDOFF.md that was in effect at reset time
      - MANIFEST.md listing every archived transcript with size and last-written time

    Returns the archive path, or None if there was nothing to archive.
    """
    if not jsonls:
        return None
    ensure_archive_dir()
    project_dir = workspace_project_dir(name)
    workspace_dir = WORKSPACES_DIR / name
    ts = time.strftime("%Y%m%d-%H%M%S")
    dest = ARCHIVE_DIR / f"{name}-{ts}-session"
    if dest.exists():
        # extreme edge: same-second collision; suffix with milliseconds
        dest = ARCHIVE_DIR / f"{name}-{ts}-{int(time.time()*1000) % 1000}-session"
    dest.mkdir(parents=True)

    import shutil
    rows = []
    moved = 0
    sidecars = 0
    for j in jsonls:
        kb = j.stat().st_size // 1024
        when = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(j.stat().st_mtime))
        # The per-session sidecar dir holds offloaded tool results the transcript points at.
        sidecar = project_dir / j.stem
        has_sidecar = sidecar.is_dir()
        shutil.move(str(j), str(dest / j.name))
        moved += 1
        if has_sidecar:
            shutil.move(str(sidecar), str(dest / sidecar.name))
            sidecars += 1
        rows.append(f"| {j.name} | {kb} KB | {when} | {'yes' if has_sidecar else 'no'} |")

    # Snapshot the handoff that was handed to the next session, so the archive records
    # exactly what the fresh session was told — and what it therefore was not told.
    handoff_src = workspace_dir / "HANDOFF.md"
    if handoff_src.exists():
        shutil.copy2(str(handoff_src), str(dest / "HANDOFF-at-reset.md"))

    manifest = [
        f"# {name} — archived session history",
        "",
        f"Archived {time.strftime('%Y-%m-%d %H:%M:%S')} by a `cw reset`.",
        f"Handoff at reset: **{handoff_note}**"
        + ("  (copy: `HANDOFF-at-reset.md`)" if handoff_src.exists() else "  (none)"),
        "",
        f"{moved} transcript(s), {sidecars} sidecar director(ies).",
        "",
        "| Transcript | Size | Last written | Sidecar |",
        "|---|---|---|---|",
    ] + rows + [
        "",
        "Restore everything back into the live project dir with:",
        "",
        f"    cw archive restore {dest.name}",
        "",
    ]
    (dest / "MANIFEST.md").write_text("\n".join(manifest))

    meta = {
        "name": name,
        "archived_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "kind": "session-only",
        "jsonl_count": moved,
        "sidecar_count": sidecars,
        "handoff": handoff_note,
        "project_dir": str(project_dir),
        "workspace_dir": str(workspace_dir),
    }
    (dest / "rotation-meta.json").write_text(json.dumps(meta, indent=2))
    return dest


def archive_list_cmd():
    """List archived workspaces. Tombstoned (.restored-*) entries are hidden."""
    if not ARCHIVE_DIR.exists():
        print("  No archives.")
        return
    entries = sorted(
        (p for p in ARCHIVE_DIR.iterdir() if p.is_dir() and not p.name.startswith(".")),
        key=lambda p: p.name, reverse=True
    )
    if not entries:
        print("  No archives.")
        return
    print(f"\n  {BOLD}Archived workspaces (~/workspaces/.archive/){RESET}")
    print(f"  {DIM}{'─'*70}{RESET}")
    for e in entries:
        if not e.is_dir():
            continue
        meta_path = e / "rotation-meta.json"
        when = ""
        kind = ""
        if meta_path.exists():
            try:
                m = json.loads(meta_path.read_text())
                when = m.get("archived_at", "")
                kind = m.get("kind", "")
            except Exception:
                pass
        size_kb = sum(f.stat().st_size for f in e.rglob("*") if f.is_file()) // 1024
        tag = f"  {DIM}(session-only){RESET}" if kind == "session-only" else ""
        print(f"  {e.name:<40} {when:<20} {size_kb} KB{tag}")
    print()


def archive_restore(archived_name):
    """Promote an archived workspace back to ~/workspaces/<original-name>/.

    archived_name is the directory name under .archive/ (e.g. 'pm-20260426-2134').
    Refuses if a live workspace with the same original name already exists.
    """
    src = ARCHIVE_DIR / archived_name
    if not src.exists():
        print(f"  {RED}Archive '{archived_name}' not found.{RESET}")
        return
    meta_path = src / "rotation-meta.json"
    if not meta_path.exists():
        print(f"  {RED}Archive missing rotation-meta.json — refusing to restore.{RESET}")
        return
    meta = json.loads(meta_path.read_text())
    name = meta["name"]

    # Session-only archives (from a light reset) hold just conversation jsonls.
    # Restore them back into the project dir; the live workspace stays untouched,
    # so we do NOT refuse when a workspace with the same name already exists.
    if meta.get("kind") == "session-only":
        project_dst = Path(meta["project_dir"])
        confirm = input(f"  Restore session history '{archived_name}' → {project_dst}? [y/N]: ").strip().lower()
        if confirm != "y":
            print(f"  {DIM}Cancelled.{RESET}")
            return
        import shutil
        project_dst.mkdir(parents=True, exist_ok=True)
        restored = 0
        for j in src.glob("*.jsonl"):
            shutil.move(str(j), str(project_dst / j.name))
            restored += 1
        # Sidecar dirs (tool-results/) must go back with their transcript, or the
        # restored history has dangling references to offloaded tool output.
        sidecars = 0
        for d in [p for p in src.iterdir() if p.is_dir()]:
            target = project_dst / d.name
            if target.exists():
                print(f"  {YELLOW}Skipping sidecar {d.name} — already present in project dir.{RESET}")
                continue
            shutil.move(str(d), str(target))
            sidecars += 1
        src.rename(src.parent / f".restored-{src.name}")
        print(f"  {GREEN}Restored {restored} session jsonl + {sidecars} sidecar dir(s) → {project_dst}{RESET}")
        return

    workspace_dst = Path(meta["workspace_dir"])
    project_dst = Path(meta["project_dir"])
    if workspace_dst.exists():
        print(f"  {RED}A live workspace already exists at {workspace_dst}.{RESET}")
        print(f"  {DIM}Rotate or delete it first before restoring.{RESET}")
        return
    confirm = input(f"  Restore '{archived_name}' → {workspace_dst}? [y/N]: ").strip().lower()
    if confirm != "y":
        print(f"  {DIM}Cancelled.{RESET}")
        return
    import shutil

    # Resilient restore: each subdir restored independently. If a prior partial restore
    # already moved one half out, we just skip that half and complete the other.
    if (src / "workspace").exists():
        if workspace_dst.exists():
            shutil.rmtree(str(workspace_dst))
        (src / "workspace").rename(workspace_dst)
        print(f"  {GREEN}Restored workspace dir → {workspace_dst}{RESET}")
    else:
        print(f"  {YELLOW}Archive has no workspace/ — skipping workspace restore.{RESET}")

    if (src / "project").exists():
        if project_dst.exists():
            shutil.rmtree(str(project_dst))
            print(f"  {DIM}Removed orphan project dir at {project_dst}{RESET}")
        project_dst.parent.mkdir(parents=True, exist_ok=True)
        (src / "project").rename(project_dst)
        print(f"  {GREEN}Restored project dir → {project_dst}{RESET}")
    else:
        print(f"  {YELLOW}Archive has no project/ — skipping project restore.{RESET}")

    # Tombstone the archive so it doesn't show up in `archive list`.
    src.rename(src.parent / f".restored-{src.name}")
    print(f"  {GREEN}Restored '{name}' from {archived_name}.{RESET}")


def purge_archives(older_than_days=None, dry_run=False):
    """Delete archived workspaces. With older_than_days, only delete archives older than N days."""
    if not ARCHIVE_DIR.exists():
        print("  No archives.")
        return
    import shutil
    now = time.time()
    cutoff = now - (older_than_days * 86400) if older_than_days else None
    candidates = []
    for e in sorted(ARCHIVE_DIR.iterdir()):
        if not e.is_dir() or e.name.startswith("."):
            continue
        if cutoff is not None and e.stat().st_mtime > cutoff:
            continue
        candidates.append(e)
    if not candidates:
        print(f"  {DIM}No archives matched.{RESET}")
        return
    print(f"\n  {BOLD}Purge plan{RESET} ({'dry-run' if dry_run else 'will DELETE'}):")
    total_kb = 0
    for e in candidates:
        kb = sum(f.stat().st_size for f in e.rglob("*") if f.is_file()) // 1024
        total_kb += kb
        print(f"    {e.name:<40} {kb} KB")
    print(f"  {BOLD}Total: {total_kb} KB across {len(candidates)} archives.{RESET}")
    if dry_run:
        return
    confirm = input(f"\n  {RED}Permanently delete the above? [y/N]: {RESET}").strip().lower()
    if confirm != "y":
        print(f"  {DIM}Cancelled.{RESET}")
        return
    for e in candidates:
        shutil.rmtree(str(e))
    print(f"  {GREEN}Deleted {len(candidates)} archive(s).{RESET}")


def reset_workspace(name, mode="light", use_tmux=False, bg=False, reuse_handoff=False):
    """Unified context reset. One command, three modes — the safe default is 'light':

      light  (default) — handoff → compact memory → ARCHIVE the session history →
                         keep all workspace files in place → launch fresh.
                         History is preserved (recoverable) and day-to-day files stay put.
      full             — handoff → compact → archive the ENTIRE workspace dir →
                         recreate a clean workspace (CLAUDE.md + memory + handoff) → fresh.
                         Use when you want a clean slate. Delegates to rotate_workspace().
      purge            — like light, but DELETES the session history instead of archiving.
                         Reclaims disk; history is NOT recoverable.

    Ordering matters: the handoff is produced BEFORE anything is compacted, archived, or
    deleted, and a failure there aborts the reset with history untouched. A reset must
    never consume the transcripts it failed to summarise.

    reuse_handoff=True keeps an existing HANDOFF.md even when newer sessions have made it
    stale. That skips a 1-3 minute regeneration at the cost of carrying an out-of-date seed.
    """
    if mode == "full":
        rotate_workspace(name, use_tmux=use_tmux, bg=bg, reuse_handoff=reuse_handoff)
        return

    workspace_dir = WORKSPACES_DIR / name
    if not workspace_dir.exists():
        print(f"  {RED}Workspace '{name}' does not exist.{RESET}")
        return

    memory_dir = workspace_memory_dir(name)
    project_dir = workspace_project_dir(name)
    jsonls = workspace_session_jsonls(name)
    jsonl_size_kb = sum(j.stat().st_size for j in jsonls) // 1024
    mem_count = len(list(memory_dir.glob("*.md"))) if memory_dir.exists() else 0
    h_state, handoff_path, n_newer = handoff_status(name, jsonls)

    # A memory.staged/ left over from an aborted compaction must not be auto-applied:
    # applying it swaps stale (or empty) curated memory over the live memory dir.
    staged_dir = project_dir / "memory.staged"
    if staged_dir.exists():
        print(f"\n  {RED}A staged compaction is already pending for '{name}'.{RESET}")
        print(f"  {DIM}{staged_dir} ({len(list(staged_dir.glob('*.md')))} .md files){RESET}")
        print(f"  {DIM}Resolve it first, then re-run the reset:{RESET}")
        print(f"    cw compact {name} --apply     # accept it")
        print(f"    cw compact {name} --discard   # throw it away")
        return

    destructive = (mode == "purge")
    if destructive:
        hist_line = f"{RED}will be DELETED (not recoverable){RESET}"
    else:
        hist_line = f"will be archived → ~/workspaces/.archive/{name}-<ts>-session/ ({GREEN}recoverable{RESET})"

    if h_state == "current":
        handoff_line = f"{GREEN}present and current{RESET} (written after the last session) — will reuse"
        need_handoff = False
    elif h_state == "stale":
        age = time.strftime("%Y-%m-%d", time.localtime(handoff_path.stat().st_mtime))
        if reuse_handoff:
            handoff_line = (f"{YELLOW}present but STALE{RESET} (written {age}; {n_newer} session(s) since) "
                            f"— {YELLOW}reusing anyway (--reuse-handoff){RESET}")
            need_handoff = False
        else:
            handoff_line = (f"{YELLOW}present but STALE{RESET} (written {age}; {n_newer} session(s) since) "
                            f"— will REGENERATE")
            need_handoff = True
    else:
        handoff_line = ("missing — will generate from session history" if jsonls
                        else f"{YELLOW}missing, and no session history to generate from{RESET}")
        need_handoff = bool(jsonls)

    print(f"\n  {BOLD}Reset plan for '{name}'  [{mode}]:{RESET}")
    print(f"    Session files:        {len(jsonls)} jsonl ({jsonl_size_kb} KB total)")
    print(f"    Memory entries:       {mem_count}")
    print(f"    HANDOFF.md:           {handoff_line}")
    print(f"    Compaction:           {'will run' if mem_count > 0 else 'skip (no memory yet)'}")
    print(f"    Workspace files:      {BOLD}UNCHANGED{RESET} (dashboards, scripts, data stay)")
    print(f"    Session history:      {hist_line}")
    if need_handoff and len(jsonls) > HANDOFF_REVIEW_LIMIT + 1:
        print(f"    {YELLOW}Note:{RESET} only the newest {HANDOFF_REVIEW_LIMIT + 1} of {len(jsonls)} transcripts")
        print(f"                          will be mined for the handoff; the rest are archived unread.")
    print()
    confirm = input(f"  Proceed? [y/N]: ").strip().lower()
    if confirm != "y":
        print(f"  {DIM}Cancelled.{RESET}")
        return

    # 1. Stop tmux session if running.
    tmux_name = TMUX_PREFIX + name
    if tmux_session_exists(tmux_name):
        print(f"  {YELLOW}Stopping running tmux session…{RESET}")
        subprocess.run(["tmux", "kill-session", "-t", "=" + tmux_name], capture_output=True)

    # 2. HANDOFF.md FIRST — this is the only thing that survives the reset, so it is
    #    produced while every transcript is still in place, and a failure aborts here.
    print(f"\n  {BOLD}Step 1/3: HANDOFF.md…{RESET}")
    if not need_handoff:
        print(f"  {DIM}Reusing existing HANDOFF.md ({h_state}).{RESET}")
        handoff_note = f"reused ({h_state})"
    elif not jsonls:
        print(f"  {YELLOW}No session transcripts — proceeding without a seed file.{RESET}")
        handoff_note = "none (no session history)"
    else:
        if h_state == "stale":
            print(f"  {DIM}Existing handoff predates {n_newer} transcript(s) — regenerating.{RESET}")
        if handoff_from_jsonl(name) is None:
            print(f"\n  {RED}Handoff generation failed — reset aborted.{RESET}")
            print(f"  {DIM}Nothing was compacted, archived, or deleted. All history is intact.{RESET}")
            print(f"  {DIM}Retry the handoff:   cw handoff {name} --from-jsonl{RESET}")
            print(f"  {DIM}Or reset reusing the old handoff:  cw reset {name} --reuse-handoff{RESET}")
            return
        handoff_note = "regenerated"

    # 3. Compact memory (if any). A curator failure leaves memory alone rather than
    #    swapping an empty staging dir over it.
    if mem_count > 0:
        print(f"\n  {BOLD}Step 2/3: Compacting memory…{RESET}")
        staged = compact_plan(name)
        if staged is not None:
            compact_apply(name)
        else:
            print(f"  {YELLOW}No usable staging produced — memory kept as-is ({mem_count} entries).{RESET}")
    else:
        print(f"\n  {BOLD}Step 2/3: Compaction skipped (no memory yet).{RESET}")

    # 4. Archive (default) or purge (opt-in) the session history.
    import shutil
    if destructive:
        print(f"\n  {BOLD}Step 3/3: Deleting session history…{RESET}")
        for j in jsonls:
            sidecar = project_dir / j.stem
            j.unlink()
            if sidecar.is_dir():
                shutil.rmtree(str(sidecar))
            print(f"  {DIM}Removed {j.name}{RESET}")
        archived_as = "purge (deleted)"
    else:
        print(f"\n  {BOLD}Step 3/3: Archiving session history…{RESET}")
        arch = archive_session_jsonls(name, jsonls, handoff_note=handoff_note)
        if arch is not None:
            print(f"  {GREEN}Archived {len(jsonls)} jsonl → {arch.name}{RESET}")
            print(f"  {DIM}Inventory: ~/workspaces/.archive/{arch.name}/MANIFEST.md{RESET}")
            print(f"  {DIM}Recover later with: cw archive restore {arch.name}{RESET}")
            archived_as = arch.name
        else:
            print(f"  {DIM}No session jsonl to archive.{RESET}")
            archived_as = "reset (no session)"

    # Clear session metadata so next launch starts fresh.
    sessions = load_sessions()
    if name in sessions:
        del sessions[name]
        save_sessions(sessions)

    # Record in LINEAGE.md — the handoff column records what actually happened, so a
    # reused stale handoff is visible in the log instead of reading as a clean "yes".
    after_count = len(list(memory_dir.glob("*.md"))) if memory_dir.exists() else 0
    append_lineage_refresh(name, mem_count, after_count, handoff_note, label=archived_as)

    print(f"\n  {GREEN}Reset complete ({mode}).{RESET}")
    print(f"  {DIM}Workspace files: untouched{RESET}")
    print(f"  {DIM}Memory: {after_count} entries (was {mem_count}){RESET}")
    print(f"  {DIM}Handoff: {handoff_note}{RESET}")
    print(f"  {DIM}Session history: {'deleted' if destructive else 'archived (recoverable)'}{RESET}")

    # 5. Offer to launch fresh.
    launch_now = input(f"\n  Launch '{name}' now in fresh mode? [Y/n]: ").strip().lower()
    if launch_now != "n":
        seed = workspace_dir / "HANDOFF.md"
        launch_workspace(name, use_tmux=use_tmux, fresh=True,
                         seed_file=seed if seed.exists() else None, bg=bg)


# ---------------------------------------------------------------------------
# Rotation safety: .rotate-keep, bound-service detection, loss preview.
# Added 2026-09-02. Before this, .rotate-keep was documented in
# /home/openclaw/CLAUDE.md but read by nothing, so 24 workspaces carried a file
# that protected nothing and at least one lost its bin/ and aws/ to a
# rotation that its own handoff believed was safe.
# ---------------------------------------------------------------------------

# What rotation has always carried forward, regardless of .rotate-keep.
ALWAYS_KEEP = ("CLAUDE.md", "HANDOFF.md", "LINEAGE.md", "handoffs")


def read_rotate_keep(workspace_dir):
    """Workspace-relative paths listed in .rotate-keep.

    Blank lines and '#' comments are ignored. Absolute paths and anything
    containing '..' are rejected rather than silently resolved, so a stray
    entry cannot reach outside the workspace during the copy.
    """
    f = Path(workspace_dir) / ".rotate-keep"
    if not f.exists():
        return []
    keep, rejected = [], []
    for raw in f.read_text(errors="replace").splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        p = Path(line)
        if p.is_absolute() or ".." in p.parts:
            rejected.append(line)
            continue
        if line in ALWAYS_KEEP:
            continue  # already carried; listing it is harmless but redundant
        keep.append(line)
    if rejected:
        print(f"  {YELLOW}Ignoring unsafe .rotate-keep entries: {', '.join(rejected)}{RESET}")
    return keep


def units_bound_to_workspace(name):
    """User systemd units whose WorkingDirectory or ExecStart points into this
    workspace. Rotating out from under one produces a permanent restart loop:
    datasheets-dashboard.service restarted 675,294 times over 46 days that way.
    """
    unit_dir = Path.home() / ".config" / "systemd" / "user"
    if not unit_dir.is_dir():
        return []
    target = str(WORKSPACES_DIR / name)
    hits = []
    for u in sorted(unit_dir.glob("*.service")):
        try:
            text = u.read_text(errors="replace")
        except Exception:
            continue
        for line in text.splitlines():
            line = line.strip()
            if not (line.startswith("WorkingDirectory=") or line.startswith("ExecStart=")):
                continue
            if target + "/" in line or line.rstrip().endswith(target):
                state = subprocess.run(
                    ["systemctl", "--user", "is-active", u.name],
                    capture_output=True, text=True).stdout.strip()
                hits.append((u.name, state))
                break
    return hits


def rotation_losses(workspace_dir, keep):
    """Top-level entries that will NOT survive the rotation.

    A path kept via .rotate-keep may be nested (e.g. marketing/content-index),
    so a top-level entry counts as surviving if anything kept lives under it.
    """
    workspace_dir = Path(workspace_dir)
    kept_roots = {Path(k).parts[0] for k in keep} | set(ALWAYS_KEEP)
    lost = []
    for entry in sorted(workspace_dir.iterdir()):
        if entry.name in kept_roots or entry.name == ".rotate-keep":
            continue
        lost.append(entry.name + ("/" if entry.is_dir() else ""))
    return lost


def copy_kept_paths(workspace_dir, dest_root, keep):
    """Copy .rotate-keep paths into dest_root, preserving relative structure."""
    import shutil
    copied, missing = [], []
    for rel in keep:
        src = Path(workspace_dir) / rel
        if not src.exists():
            missing.append(rel)
            continue
        dst = Path(dest_root) / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        if src.is_dir():
            shutil.copytree(str(src), str(dst), symlinks=True, dirs_exist_ok=True)
        else:
            shutil.copy2(str(src), str(dst))
        copied.append(rel)
    return copied, missing


def rotate_workspace(name, use_tmux=False, bg=False, reuse_handoff=False):
    """Headline rotation: compact → handoff → archive → re-create → fresh launch.

    Same-name rotation: the workspace is archived under .archive/<name>-<ts>/ and a fresh
    workspace is created at the same path, carrying forward CLAUDE.md and the *compacted*
    memory entries. The previous session's HANDOFF.md is the seed for the new session.
    """
    workspace_dir = WORKSPACES_DIR / name
    if not workspace_dir.exists():
        print(f"  {RED}Workspace '{name}' does not exist.{RESET}")
        return

    # 1. Plan + confirm.
    memory_dir = workspace_memory_dir(name)
    project_dir = workspace_project_dir(name)
    jsonls = workspace_session_jsonls(name)
    jsonl_size_kb = (jsonls[0].stat().st_size // 1024) if jsonls else 0
    mem_count = len(list(memory_dir.glob("*.md"))) if memory_dir.exists() else 0
    h_state, handoff_existing, n_newer = handoff_status(name, jsonls)

    # Never auto-apply a staging dir left behind by an aborted compaction.
    staged_dir = project_dir / "memory.staged"
    if staged_dir.exists():
        print(f"\n  {RED}A staged compaction is already pending for '{name}'.{RESET}")
        print(f"  {DIM}Resolve it first:  cw compact {name} --apply  |  cw compact {name} --discard{RESET}")
        return

    if h_state == "current":
        handoff_line = f"{GREEN}present and current{RESET} — will adopt"
        need_handoff = False
    elif h_state == "stale":
        age = time.strftime("%Y-%m-%d", time.localtime(handoff_existing.stat().st_mtime))
        if reuse_handoff:
            handoff_line = f"{YELLOW}STALE{RESET} (written {age}; {n_newer} session(s) since) — reusing (--reuse-handoff)"
            need_handoff = False
        else:
            handoff_line = f"{YELLOW}STALE{RESET} (written {age}; {n_newer} session(s) since) — will REGENERATE"
            need_handoff = True
    else:
        handoff_line = ("missing — will generate from jsonl" if jsonls
                        else f"{YELLOW}missing, and no session history to generate from{RESET}")
        need_handoff = bool(jsonls)

    keep = read_rotate_keep(workspace_dir)
    losses = rotation_losses(workspace_dir, keep)
    bound_units = units_bound_to_workspace(name)

    print(f"\n  {BOLD}Rotation plan for '{name}':{RESET}")
    print(f"    Session transcripts:  {len(jsonls)}  (newest: {jsonls[0].name if jsonls else '(none)'}, {jsonl_size_kb} KB)")
    print(f"    Memory entries:       {mem_count}")
    print(f"    HANDOFF.md:           {handoff_line}")
    print(f"    Compaction:           {'will run' if mem_count > 0 else 'skip (no memory yet)'}")
    print(f"    Archive target:       ~/workspaces/.archive/{name}-{time.strftime('%Y%m%d-%H%M%S')}/")
    print(f"    New workspace:        ~/workspaces/{name}/  (fresh, seeded with HANDOFF.md)")

    if keep:
        print(f"    {GREEN}.rotate-keep:{RESET}         {len(keep)} path(s) carried forward")
        for k in keep:
            exists = (workspace_dir / k).exists()
            mark = f"{GREEN}+{RESET}" if exists else f"{YELLOW}? missing{RESET}"
            print(f"                            {mark} {k}")
    else:
        print(f"    .rotate-keep:         none (only CLAUDE.md, HANDOFF.md, LINEAGE.md, handoffs/, memory survive)")

    if losses:
        print(f"\n    {RED}Will be archived away and REMOVED from the workspace:{RESET}")
        shown = losses[:15]
        for l in shown:
            print(f"      {RED}-{RESET} {l}")
        if len(losses) > len(shown):
            print(f"      {DIM}... and {len(losses) - len(shown)} more{RESET}")
        print(f"    {DIM}Recoverable from the archive, but not automatically.{RESET}")

    git_at_risk = (workspace_dir / ".git").is_dir() and ".git/" in losses
    if git_at_risk:
        print(f"\n  {RED}{BOLD}WARNING: this workspace is a git repository and .git is NOT in .rotate-keep.{RESET}")
        print(f"  {YELLOW}Rotating archives the entire history. If there is no remote, the archive")
        print(f"  is the only copy. Add a line reading '.git' to .rotate-keep first.{RESET}")

    if bound_units:
        print(f"\n  {RED}{BOLD}WARNING: {len(bound_units)} systemd unit(s) run out of this workspace.{RESET}")
        for uname, state in bound_units:
            print(f"      {RED}!{RESET} {uname}  [{state}]")
        print(f"  {YELLOW}Rotating moves the directory they point at. They will fail on every")
        print(f"  restart until repointed, forever. Add their paths to .rotate-keep, or")
        print(f"  stop them and update the units first.{RESET}")

    print()
    if bound_units or git_at_risk:
        confirm = input(f"  Proceed anyway? Type {BOLD}rotate{RESET} to confirm: ").strip().lower()
        confirm = "y" if confirm == "rotate" else "n"
    else:
        confirm = input(f"  Proceed? [y/N]: ").strip().lower()
    if confirm != "y":
        print(f"  {DIM}Cancelled.{RESET}")
        return

    # 2. Stop tmux session if running (clean snapshot).
    tmux_name = TMUX_PREFIX + name
    if tmux_session_exists(tmux_name):
        print(f"  {YELLOW}Stopping running tmux session…{RESET}")
        subprocess.run(["tmux", "kill-session", "-t", "=" + tmux_name], capture_output=True)

    # 3. HANDOFF.md first — rotation archives the whole workspace, so the handoff is
    #    produced while the transcripts are still in place and a failure aborts here.
    print(f"\n  {BOLD}Step 1/4: HANDOFF.md…{RESET}")
    if not need_handoff:
        print(f"  {DIM}Using existing HANDOFF.md ({h_state}).{RESET}")
        handoff_note = f"reused ({h_state})"
    elif not jsonls:
        print(f"  {YELLOW}No jsonl + no HANDOFF.md — proceeding without a seed file.{RESET}")
        handoff_note = "none (no session history)"
    else:
        if handoff_from_jsonl(name) is None:
            print(f"\n  {RED}Handoff generation failed — rotation aborted.{RESET}")
            print(f"  {DIM}Nothing was compacted or archived. The workspace is untouched.{RESET}")
            print(f"  {DIM}Retry: cw handoff {name} --from-jsonl, or cw reset {name} --full --reuse-handoff{RESET}")
            return
        handoff_note = "regenerated"

    # 4. Compact (auto-apply for atomic rotation flow).
    before_count = mem_count
    after_count = mem_count
    if mem_count > 0:
        print(f"\n  {BOLD}Step 2/4: Compacting memory…{RESET}")
        staged = compact_plan(name)
        if staged is None:
            print(f"  {RED}Compaction produced no usable staging dir — aborting rotation.{RESET}")
            print(f"  {DIM}Nothing was archived. Memory is untouched ({mem_count} entries).{RESET}")
            return
        after_count = len(list(staged.glob("*.md")))
        compact_apply(name)

    # 5. Snapshot what we're carrying forward, archive the rest.
    print(f"\n  {BOLD}Step 3/4: Archiving old workspace…{RESET}")
    import shutil
    snapshot_dir = Path("/tmp") / f"cw-rotate-{name}-{int(time.time())}"
    snapshot_dir.mkdir()
    # CLAUDE.md
    if (workspace_dir / "CLAUDE.md").exists():
        shutil.copy2(str(workspace_dir / "CLAUDE.md"), str(snapshot_dir / "CLAUDE.md"))
    # HANDOFF.md (if any)
    if (workspace_dir / "HANDOFF.md").exists():
        shutil.copy2(str(workspace_dir / "HANDOFF.md"), str(snapshot_dir / "HANDOFF.md"))
    # LINEAGE.md (if any) — append-only history carries forward
    if (workspace_dir / "LINEAGE.md").exists():
        shutil.copy2(str(workspace_dir / "LINEAGE.md"), str(snapshot_dir / "LINEAGE.md"))
    # handoffs/ — the chain of superseded handoffs carries forward too, so the record of
    # what each past reset told the next session survives the rotation.
    if handoff_history_dir(name).exists():
        shutil.copytree(str(handoff_history_dir(name)), str(snapshot_dir / "handoffs"))
    # Compacted memory dir
    if memory_dir.exists():
        shutil.copytree(str(memory_dir), str(snapshot_dir / "memory"))
    # .rotate-keep paths, plus the file itself so the next rotation still honours it
    kept_copied, kept_missing = copy_kept_paths(workspace_dir, snapshot_dir / "keep", keep)
    if (workspace_dir / ".rotate-keep").exists():
        shutil.copy2(str(workspace_dir / ".rotate-keep"), str(snapshot_dir / "rotate-keep"))
    if kept_copied:
        print(f"  {GREEN}Carrying forward {len(kept_copied)} .rotate-keep path(s).{RESET}")
    if kept_missing:
        print(f"  {YELLOW}.rotate-keep lists {len(kept_missing)} path(s) that do not exist: "
              f"{', '.join(kept_missing)}{RESET}")

    archive_root = archive_workspace(name)
    if archive_root is None:
        print(f"  {RED}Archive failed — snapshot retained at {snapshot_dir}{RESET}")
        return

    # 6. Re-create workspace + project dir from snapshot.
    print(f"\n  {BOLD}Step 4/4: Creating fresh workspace…{RESET}")
    workspace_dir.mkdir(parents=True)
    if (snapshot_dir / "CLAUDE.md").exists():
        shutil.copy2(str(snapshot_dir / "CLAUDE.md"), str(workspace_dir / "CLAUDE.md"))
    if (snapshot_dir / "HANDOFF.md").exists():
        shutil.copy2(str(snapshot_dir / "HANDOFF.md"), str(workspace_dir / "HANDOFF.md"))
    if (snapshot_dir / "LINEAGE.md").exists():
        shutil.copy2(str(snapshot_dir / "LINEAGE.md"), str(workspace_dir / "LINEAGE.md"))
    if (snapshot_dir / "handoffs").exists():
        shutil.copytree(str(snapshot_dir / "handoffs"), str(handoff_history_dir(name)))

    if (snapshot_dir / "rotate-keep").exists():
        shutil.copy2(str(snapshot_dir / "rotate-keep"), str(workspace_dir / ".rotate-keep"))
    if (snapshot_dir / "keep").exists():
        for item in sorted((snapshot_dir / "keep").iterdir()):
            dst = workspace_dir / item.name
            if item.is_dir():
                shutil.copytree(str(item), str(dst), symlinks=True, dirs_exist_ok=True)
            else:
                shutil.copy2(str(item), str(dst))

    # Re-create the Claude project dir + carry compacted memory forward.
    project_dir.mkdir(parents=True)
    if (snapshot_dir / "memory").exists():
        shutil.copytree(str(snapshot_dir / "memory"), str(memory_dir))

    append_lineage(name, archive_root.name, before_count, after_count, handoff_note)
    shutil.rmtree(str(snapshot_dir))

    print(f"\n  {GREEN}Rotation complete.{RESET}")
    print(f"  {DIM}Old: ~/workspaces/.archive/{archive_root.name}/{RESET}")
    print(f"  {DIM}New: {workspace_dir} (memory: {after_count} entries){RESET}")

    # 7. Launch fresh.
    launch_now = input(f"\n  Launch '{name}' now in fresh mode? [Y/n]: ").strip().lower()
    if launch_now != "n":
        seed = workspace_dir / "HANDOFF.md"
        launch_workspace(name, use_tmux=use_tmux, fresh=True,
                         seed_file=seed if seed.exists() else None, bg=bg)


